# Copy this file to .env.local and fill in what you need.
#
#   cp .env.example .env.local
#
# .env.local is gitignored. Nothing in it is ever sent to the browser: none of
# these names begin with NEXT_PUBLIC_, which is the only prefix Next inlines
# into the client bundle. Restart the dev server after editing.

# ============================================================================
# Database  — required for accounts. The rest of the site runs without it.
# ============================================================================
#
# A local one, matching docker-compose.yml:
#   docker compose up -d db
#
# Or any hosted Postgres — Neon, Supabase, Railway, RDS. Managed providers
# usually want ?sslmode=require on the end.
DATABASE_URL=postgresql://maison:maison@localhost:5432/maison_noir?schema=public

# ============================================================================
# Sessions — required for accounts
# ============================================================================
#
# Signs session tokens, pending-registration tickets and OAuth state. At least
# 32 characters; the app refuses to start signing tokens with anything shorter.
# Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Use a different value in production, keep it out of version control, and
# treat changing it as signing every member out — which is what it does.
AUTH_SECRET=

# The absolute origin this deployment is served from, with no trailing slash.
# Every verification link, reset link and OAuth callback URL is built from it,
# so a wrong value here sends people to the wrong place.
APP_ORIGIN=http://localhost:3000

# ============================================================================
# Email  — required to send verification codes and reset links
# ============================================================================
#
# Any SMTP provider works — Resend, Postmark, SendGrid, Brevo, Mailgun, Fastmail.
# Resend:   smtp.resend.com : 587, user "resend", pass = your API key
# Postmark: smtp.postmarkapp.com : 587
# Brevo:    smtp-relay.brevo.com : 587, user = the generated Login, pass = SMTP key
#
# Leave SMTP_HOST unset in development: every route still runs end to end and
# writes the rendered message to .mail/ instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Must be an address on a domain you have verified with the provider,
# otherwise the message will be rejected or land in spam.
MAIL_FROM="Maison Noir <hello@maisonnoir.example>"

# Where a visitor's reply goes.
MAIL_REPLY_TO="studio@maisonnoir.example"

# Optional: also notify the workshop that an enquiry came in.
MAIL_NOTIFY_TO=

# ============================================================================
# SMS  — optional. Without it, phone verification cannot complete.
# ============================================================================
#
# Twilio, called over its REST API — no SDK is installed. From the console:
# https://console.twilio.com — the Account SID and Auth Token are on the
# dashboard, the number under Phone Numbers.
#
# Left unset, a phone code is written to .sms/ and printed to the server log,
# so the whole registration flow can be walked through before buying an SMS
# plan. The verification screen says plainly that nothing was sent rather than
# telling someone to check a phone that will never ring.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+15005550006

# Optional: a Messaging Service takes precedence over TWILIO_FROM when set.
TWILIO_MESSAGING_SERVICE_SID=

# ============================================================================
# Google sign-in  — optional. Without it, the button is not shown at all.
# ============================================================================
#
# https://console.cloud.google.com/apis/credentials
#   1. Create an OAuth client ID, type "Web application".
#   2. Authorised redirect URI — exactly, including the port:
#        http://localhost:3000/api/auth/google/callback
#      and the same path on your live origin.
#   3. On the OAuth consent screen, the only scopes needed are
#      .../auth/userinfo.email, .../auth/userinfo.profile and openid.
#
# The secret is read on the server and never reaches the browser. If it ever
# appears in a client bundle, it has been renamed with a NEXT_PUBLIC_ prefix —
# rotate it immediately.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only needed when the callback is not APP_ORIGIN + /api/auth/google/callback,
# such as behind a proxy that rewrites the path.
GOOGLE_REDIRECT_URI=
